# Shared Cloud Database (Neon pooled connection string with sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# App Server Auth & Clock Demo Config (4x user laptops)
JWT_SECRET=replace-with-32-plus-char-random-secret
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=3001
NODE_NAME=laptop-bagas
CLOCK_SKEW_MS=0
CLIENT_ORIGIN=http://localhost:5173

# Backup Storage PC Config (1x desktop/PC on shared mobile hotspot)
BACKUP_API_KEY=sister-demo-backup-key-2026
BACKUP_PC_URL=http://192.168.43.10:4000
BACKUP_DIR=./backups
BACKUP_SERVER_HOST=0.0.0.0
BACKUP_SERVER_PORT=4000

# React + Vite Client
VITE_API_URL=http://localhost:3001

# Pre-seeded Demo Accounts Password (bagas, yasmin, fathoni, allia, allysa, lia)
SEED_DEFAULT_PASSWORD=SisterDemo2026!
